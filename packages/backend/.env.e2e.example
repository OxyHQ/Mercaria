# =============================================================================
# Real-store connector verification (#69) — environment template
# =============================================================================
#
# Copy to `.env.e2e` (gitignored) and fill in. This is a NON-PRODUCTION
# deployment: a local API pointed at its own throwaway database and its own
# Redis, plus a public tunnel so a real WooCommerce site can reach the webhook
# address. It is the environment `docs/runbooks/connector-real-store-verification.md`
# §2 describes.
#
# Run the API with it:
#   set -a; . packages/backend/.env.e2e; set +a; bun run --cwd packages/backend dev
#
# NO SECRET GOES IN THIS FILE. `.env.e2e` is gitignored; this template is not,
# so every line below is a name and a note, never a value.
#
# The variable names here were read out of the code, not out of a handoff table:
#   DATABASE_URL / PORT                 src/index.ts
#   CONNECTOR_ENCRYPTION_KEY            src/lib/connector-crypto.ts
#   CONNECTOR_OAUTH_*                   src/connectors/config.ts
#   CONNECTOR_DEFAULT_CATEGORY_SLUG     src/services/connector-sync.service.ts
#   CONNECTOR_WEBHOOK_REREGISTRATION_*  src/config/index.ts
#   REDIS_URL                           src/lib/redis.ts
#   SHOPIFY_*                           src/connectors/shopify/config.ts

# --- Database ----------------------------------------------------------------
# REQUIRED to boot. Give this run its OWN database — never a test database
# (`oxydb_test_*` are created and dropped per suite run) and never the shared
# dev default, because a backfill of a real catalogue writes thousands of rows.
#
# Create it from the PostGIS template, since a database cloned from `template1`
# has no PostGIS and the migrator's extension precondition fails on a FRESH
# database only:
#   docker exec mercaria-postgres-dev psql -U mercaria -d postgres \
#     -c "CREATE DATABASE mercaria_e2e_69 TEMPLATE template_postgis;"
# then migrate it with the REAL migrator (never `drizzle-kit migrate`):
#   DATABASE_URL=... bun run --cwd packages/backend db:migrate -- \
#     --target-database=mercaria_e2e_69 --phase=all
DATABASE_URL=postgres://mercaria:mercaria@127.0.0.1:5435/mercaria_e2e_69

# --- API server --------------------------------------------------------------
PORT=4169
WEB_URL=http://localhost:8160
LOG_LEVEL=debug

# --- Oxy auth ----------------------------------------------------------------
# The `/admin` tree is gated by real Oxy auth (`createOxyAuthMiddleware`), so the
# driver needs a real bearer token for an account that is a member of the store
# with `channels:write`. There is no local bypass and none may be added.
OXY_API_URL=https://api.oxy.so

# --- Redis: LOAD-BEARING for #69 acceptance 4, not optional ------------------
# Without it `getSyncQueue()` returns null and `enqueueConnectionBackfill` runs
# the backfill INLINE inside the HTTP request (`src/queue/producers.ts`), so a
# large catalogue times out and NEITHER scheduled sweep exists — not the 6-hour
# catalogue reconcile, not the 15-minute webhook re-registration sweep.
#
# "Enqueued" and "ran inline" answer the same 202, so the run must be PROVEN:
# `scripts/e2e/queue-evidence.ts` counts `bull:marketplace-sync:*` jobs across
# the request and measures the response latency against the run's own duration.
REDIS_URL=redis://127.0.0.1:6379

# --- Connectors --------------------------------------------------------------
# AES-256-GCM key for stored platform credentials. 64 hex characters:
#   openssl rand -hex 32
# Durable: rotating it makes every stored credential undecryptable.
CONNECTOR_ENCRYPTION_KEY=

# Signs the OAuth `state` CSRF token. 64 hex characters:
#   openssl rand -hex 32
CONNECTOR_OAUTH_STATE_SECRET=

# The PUBLIC base of THIS backend. Both the OAuth callback and the webhook
# delivery address are built from this one value, so for a real store it must be
# the tunnel hostname (`https://<name>.trycloudflare.com`), never `localhost` —
# WooCommerce and Shopify deliver from the internet.
CONNECTOR_OAUTH_REDIRECT_BASE_URL=

# Optional; without it the OAuth callback renders a plain success page.
CONNECTOR_OAUTH_SUCCESS_REDIRECT_URL=

# An EXISTING category slug every imported product is filed under. A slug that
# does not exist fails the backfill with a clear error, and a freshly migrated
# database has NO categories — `scripts/e2e/setup.ts` creates this one.
CONNECTOR_DEFAULT_CATEGORY_SLUG=home

# #262's re-registration sweep. Default ON; it gates the LOOP and nothing
# durable. Leave it on — W7's recovery path is what it exercises.
# CONNECTOR_WEBHOOK_REREGISTRATION_ENABLED=true
# CONNECTOR_WEBHOOK_REREGISTRATION_BATCH_SIZE=10
# CONNECTOR_WEBHOOK_REREGISTRATION_LEASE_MS=120000

# --- Shopify (only for the S scenarios; the W scenarios need none of it) ------
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_SCOPES is NOT needed: the code default is already the full runbook
# §3.2 string (`connectors/shopify/config.ts` DEFAULT_SCOPES). Set it ONLY to
# request something NARROWER — which is the configuration that caused #218.

# --- The driver's own inputs -------------------------------------------------
# Where the running API is, for the driver process.
E2E_API_BASE_URL=http://127.0.0.1:4169

# A real Oxy bearer token for the operator account. NEVER committed, never
# written into evidence — the collector registers it as a watched secret and
# refuses to write an artefact it appears in.
E2E_OXY_ACCESS_TOKEN=

# The Oxy account id that token belongs to. `setup.ts` makes it the store owner.
E2E_OXY_USER_ID=

# The WooCommerce credential file the provisioning agent writes, mode 600,
# holding {siteUrl, consumerKey, consumerSecret}. Never inline those here.
E2E_WOO_CREDENTIALS_FILE=/home/nate/.config/oxy/tokens/mercaria-woo-e2e.json

# Where the redacted evidence is written.
E2E_EVIDENCE_DIR=
