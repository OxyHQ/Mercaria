# ================================
# DATABASE
# ================================
# PostgreSQL connection string, including the database name. REQUIRED — every
# route this API serves is backed by Postgres, so the config REFUSES TO LOAD
# without it rather than letting a task boot and answer 500 per request.
# Start a local server with:
#   docker compose -f docker-compose.postgres.yml up -d postgres
DATABASE_URL=postgres://mercaria:mercaria@127.0.0.1:5435/mercaria_dev

# Server the test harness creates its OWN throwaway database on, per run. It is
# never written to. Falls back to DATABASE_URL, then to the compose server above.
# TEST_DATABASE_URL=

# postgres.js pool tuning, per task. Defaults shown.
# PG_MAX_POOL_SIZE=20
# PG_IDLE_TIMEOUT_SECONDS=30
# PG_CONNECT_TIMEOUT_SECONDS=10
# PG_MAX_LIFETIME_SECONDS=1800

# ================================
# API SERVER
# ================================
# Port the API listens on.
PORT=3001

# Web app origin (for CORS).
WEB_URL=http://localhost:8160
# Merchant dashboard origin — where a store returns from Peable's hosted
# seller onboarding. Defaults to https://dashboard.mercaria.co.
# DASHBOARD_URL=http://localhost:8170

# ================================
# OXY AUTH
# ================================
# Base URL of the Oxy API used to validate sessions/service tokens.
OXY_API_URL=https://api.oxy.so

# There is no Mercaria service secret and no internal bot secret (#164). A
# server-to-server caller authenticates as a registered Oxy Application against
# a credential issued in Oxy Console, verified by `oxyClient.serviceAuth(...)`
# on the route that needs it. A deployment-local shared secret is not a
# principal: it names no Application, appears in no grant audit, and rotates
# and revokes only where it happens to be set.

# ================================
# CATALOG LIMITS
# ================================
# Most variants one product may carry. A product with more is REFUSED WHOLE —
# never truncated, because a silently shortened variant set unpublishes real
# variants (#259) — on every path that writes one, including a connector import
# of a merchant's own catalogue. That makes it a limit an operator has to be able
# to find: a real WooCommerce store with a 110-variation product loses exactly
# that product on every sync, and the run's own summary is what says so (#294).
# Raise it above the largest product any connected store legitimately sells.
# MAX_VARIANTS_PER_PRODUCT=100

# ================================
# CONNECTORS (external platform sync)
# ================================
# AES-256-GCM key used to encrypt external-platform credentials at rest (Shopify
# OAuth tokens, WooCommerce keys, …). REQUIRED once a connector is configured;
# the crypto helper fails closed with a clear error if it is missing or malformed
# when a credential is encrypted/decrypted. Must be a 64-character hex string
# (32 bytes). Generate with:
#   openssl rand -hex 32
# CONNECTOR_ENCRYPTION_KEY=

# HMAC secret used to sign/verify the OAuth `state` CSRF token exchanged during a
# connect flow. REQUIRED to start a connect. Generate with:
#   openssl rand -hex 32
# CONNECTOR_OAUTH_STATE_SECRET=

# Public base URL of THIS backend — used to build the OAuth callback the external
# platform redirects to (`{base}/channels/oauth/{provider}/callback`). This exact
# callback URL must be registered in the platform's app settings (deploy handoff).
# CONNECTOR_OAUTH_REDIRECT_BASE_URL=https://api.mercaria.co

# Where to send the merchant's browser after a successful connect (the dashboard's
# channels screen). Optional — when unset the callback shows a plain success page.
# CONNECTOR_OAUTH_SUCCESS_REDIRECT_URL=https://dashboard.mercaria.co/channels

# Mercaria category slug that pulled products are filed under (Fase 1). Must be an
# existing category slug (see the seed). Per-connection category mapping is Fase 2.
# CONNECTOR_DEFAULT_CATEGORY_SLUG=home

# --- Webhook re-registration (#262) ---
# Whether the scheduled sweep re-registers the platform webhooks of connections
# whose registration did not finish. Defaults ON: it gates the LOOP and nothing
# durable, the merchant's own re-register stays available with it off, and the
# catalogue reconcile beside it already calls the same two platforms every six
# hours with no lever at all. Turn it OFF to stop knocking during an incident.
# CONNECTOR_WEBHOOK_REREGISTRATION_ENABLED=true

# How many connections one sweep pass claims, and how long a claim is held before
# another task may reclaim it. The lease is what stops two passes recreating one
# connection's subscriptions concurrently, so it should comfortably outlast a
# registration (a handful of calls to the merchant's platform).
# CONNECTOR_WEBHOOK_REREGISTRATION_BATCH_SIZE=10
# CONNECTOR_WEBHOOK_REREGISTRATION_LEASE_MS=120000

# --- Shopify Partner app (deploy handoff — register the app to get these) ---
# App API key (client id) and secret from the Shopify Partner dashboard.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# OAuth scopes to request (comma/space separated). The code default is ALREADY the
# full set `connectors/shopify/config.ts` DEFAULT_SCOPES lists — read_products,
# write_products, read_orders, read_inventory, read_locations and the two
# merchant_managed_fulfillment_orders scopes — kept in step with the registered
# webhook topics and the endpoints behind each capability by
# `shopify/__tests__/shopify-scopes.test.ts`.
#
# So leave it UNSET unless you deliberately want something NARROWER. `read_products`
# alone is exactly the configuration that caused #218: the connector registers the
# order and inventory topics unconditionally, Shopify gates each `POST /webhooks.json`
# on that topic's read scope, and the refusals become `webhookFailures` with the
# channel's catalogue readiness `degraded`.
# SHOPIFY_SCOPES=

# ================================
# REDIS (optional)
# ================================
# Enables the Redis-backed rate-limit store and Socket.IO scaling. Without it,
# the app falls back to in-memory (per-instance) behavior.
# Local:   redis://localhost:6379
# Managed: rediss://user:password@host:port
#
# An optional trailing database index (redis://localhost:6379/9) is honoured by
# every client built from this URL — the rate-limit store, the Socket.IO adapter
# and the BullMQ queues alike — which is how one service's keyspace is isolated
# on a shared Redis. An index that is not a non-negative integer is REFUSED
# (Redis is then treated as unconfigured and logged), rather than quietly
# falling back to db 0 and giving isolation that is not there.
# REDIS_URL=

# Optional CA cert (PEM) for TLS connections to managed Redis. A bare `CA_CERT`
# is accepted as a fallback (see lib/redis.ts).
# REDIS_CA_CERT=

# ================================
# WEB PUSH (optional)
# ================================
# VAPID keys for browser push notifications. Generate with:
#   bunx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@mercaria.co

# ================================
# PEABLE (optional — the card rail, ADR 0009)
# ================================
# OFF by default. Mercaria reaches the Oxy gateway with its own Oxy workload
# identity and holds no Peable credential. Turning the rail on requires the
# gateway origin AND the webhook secret: Mercaria reaches `paid` only from a
# verified event, so a rail that could create a payment and not verify its
# settlement would take money and leave every order unpaid. A half-configured
# rail logs once at boot and stays OFF. `/webhooks/peable` is mounted whenever
# the secret is set (merchant billing's events arrive there too).
#
# There is no seller onboarding on this rail yet: nothing writes
# `provider_accounts`, so with the rail on checkout refuses every seller
# (ADR 0009 D13 "As built").
# PEABLE_ENABLED=false
# PEABLE_BASE_URL=https://api.peable.to
# PEABLE_WEBHOOK_SECRET=
# PEABLE_WEBHOOK_SECRET_PREVIOUS=          # accepted too, during a rotation window
#
# The currencies a card cart may be presented in (ADR 0001 D8). A cart in
# anything else is refused at checkout, before any stock is reserved.
# PEABLE_PRESENTMENT_CURRENCIES=EUR,USD
#
# Inbound event processing. Receipt is separate from processing: a 200 means
# stored, never understood, and these tune the retry loop that interprets them.
# PEABLE_EVENT_MAX_ATTEMPTS=8
# PEABLE_EVENT_BATCH_SIZE=50
# PEABLE_EVENT_POLL_INTERVAL_MS=5000
# PEABLE_EVENT_LEASE_MS=60000
#
# Which payment SURFACES a client may render. `card` is always re-added, so a
# typo here cannot remove the card form; "no card form at all" is
# PEABLE_ENABLED=false.
# CHECKOUT_PAYMENT_SURFACE_METHODS=card,apple_pay,google_pay,link

# --- Holding a high-value transfer for review (protection 2) ---
# A minor-unit floor per currency, above which a SELLER'S share waits before it
# leaves Mercaria's balance — `EUR:100000,USD:100000`.
#
# It is a REVIEW hold, not a dispute-window hold, and the difference decides how
# long it may reasonably be. A card chargeback can arrive 120 days later and no
# marketplace holds a payout for 120 days. What the window buys is the period in
# which most card fraud actually surfaces — a cardholder reads a statement, a
# delivery fails — during which Mercaria loses the
# goods rather than the goods AND the cash.
#
# EMPTY — the shipped default — holds NOTHING, deliberately: the safe-looking
# default here would freeze every payout on a deployment nobody configured,
# which is not caution, it is an outage that looks like caution. A protective
# default is only right when the failure it causes is cheaper than the one it
# prevents.
#
# A hold is decided ONCE, when the transfer row is created, and recorded in
# `transfers.held_until`. Changing either setting afterwards never moves a hold
# already in force. Two things end one: the `withheld_transfers` reconciliation
# sweep once the window passes, and an operator's `retry_withheld_transfer`
# repair, which is the review itself and releases early. Setting the window to 0
# turns the hold off without editing the thresholds; the outstanding holds are
# still released on their own schedule rather than stranded.
# HIGH_VALUE_HOLD_THRESHOLDS=
# HIGH_VALUE_HOLD_WINDOW_MS=259200000

# --- The operator desks ---
# Nothing to set. Every /internal/* desk is gated on an Oxy APPLICATION ROLE
# (`payments.operate`, `catalog.operate`, `guest.operate`, `analytics.operate`,
# `retail.operate`, `procurement.operate`, `referrals.operate`) declared in
# Mercaria's entry of oxy's first-party registry and held by the owners and
# admins of the `oxy` organization (oxy ADR 0056; ~/Oxy/docs/application-roles.md).
# Nobody is granted a key per person: to make someone an operator, give them that
# organization role. See middleware/operator-authz.ts. Until oxy's "Seed Oxy
# applications" workflow has run for Mercaria nobody holds `payments.operate`, so
# nobody can repair a payment, publish a merchant plan or clear a withheld transfer.

# ================================
# PUBLIC ROUTING AND SEO (#75)
# ================================
# Two levers with different blast radii. With the routes off, the Cloudflare
# Worker's lookup 404s and the storefront is served exactly as it was before
# #75 — the static robots.txt and sitemap.xml the app ships are what a crawler
# gets. With indexing off, metadata still renders and every page says
# `noindex`, because a correct title and a correct sharing card are worth
# having before anybody is invited to index the catalogue. See `docs/seo.md`.
# SEO_ROUTES_ENABLED=false                 # mounts /seo/* at all
# SEO_INDEXING_MODE=off                    # off | canary | on
# SEO_CANARY_CATEGORY_IDS=                 # EMPTY under `canary` indexes NOTHING
# SEO_SITEMAP_PAGE_SIZE=25000
# SEO_DOCUMENT_CACHE_SECONDS=300
# SEO_SITEMAP_CACHE_SECONDS=3600

# ================================
# REFERRALS (#142 model, #143 attribution edge)
# ================================
# ONE master gate over the surfaces and loops; durable referral records —
# programs, partners, codes, links, touches, attributions, conversions — are
# written and kept regardless (ADR 0005 D18). Turning it on requires BOTH
# secrets: a deployment that can mint links but cannot sign the state carrier
# would redirect every anonymous click and then fail when it tried to hand the
# browser its evidence — a program that appears to work and attributes nobody.
# See `docs/referral-attribution.md`.
# REFERRALS_ENABLED=false
# REFERRAL_LINK_TOKEN_SECRET=              # signs the PUBLIC link token a partner shares
# REFERRAL_STATE_SECRET=                   # signs the carrier the server sets; a SECOND key
# REFERRAL_REDIRECT_BASE_URL=https://mercaria.co   # MUST be in lib/allowed-origins.ts
#
# Partner ENROLLMENT (#146 increment 2). Gates the MOUNT of the two partner
# surfaces — `/referral-partner` and `/admin/stores/:storeId/referral-partner` —
# and nothing durable: it stops NEW enrollment and every partner-facing
# enrollment write, and standing, acceptances, tax declarations, accrued rewards
# and payout batches all carry on. The operator review surface is gated by
# neither this nor REFERRALS_ENABLED, so a queue stays workable through whatever
# incident turned enrollment off.
#
# Defaults TRUE, unlike the loop levers below, and deliberately: this gates the
# only path by which a partner can complete ADR 0005 D15's tax gate, so shipping
# it off leaves tax readiness `pending` for everybody and every payout batch
# blocked — with silence as the symptom. It is NOT gated on REFERRALS_ENABLED,
# which demands two link secrets enrollment never reads.
# See `docs/referral-enrollment.md`.
# REFERRAL_PARTNER_ENROLLMENT_ENABLED=true

# ================================
# EXTERNAL CATALOG AND AFFILIATE (#37, #67)
# ================================
# Mercaria indexes products it does not sell and earns a commission when a
# shopper leaves for the retailer. Only the levers a deployment actually sets
# are listed; every batch size, interval and lease in these domains has a code
# default that no deployment has ever needed to override.
#
# The redirect MOUNT, not the click record: with it off the storefront renders
# its existing `redirect_unavailable` branch and writes nothing, because clicks
# are written BY the route. Requires the token secret — a signed token with no
# key to verify it against would make the destination a stranger's opinion.
# OUTBOUND_REDIRECT_ENABLED=false
# OUTBOUND_TOKEN_SECRET=                   # openssl rand -hex 32
#
# The report-poll LOOP only. Commission records, postings and reversals are
# durable regardless; this stops the polling, not the bookkeeping.
# AFFILIATE_RECONCILIATION_ENABLED=false
#
# Ingestion: the staged pipeline that turns a source's rows into offers.
# CATALOG_INGESTION_ENABLED and FEED_IMPORT_ENABLED gate the surfaces; the three
# OFFER_* levers gate the sweeps that keep an offer's price fresh and retire it
# when the source stops publishing it. Without the expiry sweep a withdrawn
# offer stays on sale forever, which is the one failure a shopper sees.
# CATALOG_INGESTION_ENABLED=true           # on by default: the catalogue autopilot feeds it (ADR 0015)
# FEED_IMPORT_ENABLED=false
# OFFER_MATERIALIZATION_ENABLED=false
# OFFER_REFRESH_ENABLED=false
# OFFER_EXPIRY_SWEEP_ENABLED=false
#
# The two network adapters. Each gates only its own REGISTRATION and nothing
# durable. Their credentials are NOT named here: a source row stores an
# `env:<NAME>` locator and the operator picks the name, so the variable is per
# deployment (see services/awin/credential.ts).
# EBAY_ENABLED=false
# EBAY_ENVIRONMENT=sandbox                 # a sandbox keyset must never feed public pages
# EBAY_MARKETS=EBAY_ES                     # ALLOW-list; a value outside EBAY_MARKETPLACE_IDS is dropped
# EBAY_FETCH_ENABLED=true                  # the HARD fetch kill switch, in front of every read
# AWIN_ENABLED=false
#
# Keyless open-data providers (docs/catalog-sources/open-data-providers.md).
# Nothing to set: every provider is registered, the sources Mercaria runs are
# declared in services/open-data/sources.ts, and the User-Agent is a constant.
# These are transport tunables with working defaults.
# OPEN_DATA_CACHE_DIR=/tmp/mercaria-open-data   # dumps shared by every source of a provider
# OPEN_DATA_REQUEST_TIMEOUT_MS=30000
# OPEN_DATA_MAX_DOWNLOAD_BYTES=268435456          # refused, never truncated
#
# /internal/ingestion, /internal/ebay, /internal/awin and the canonical graph
# surfaces are gated on `catalog.operate` (see "The operator desks" above): a
# source cannot be created without a holder.

# ================================
# GOWAY (ADR 0013) — where every store location's place facts live
# ================================
# Public reads only; no credential. Needed by NEARBY_DISCOVERY_ENABLED and
# STORE_PICKUP_ENABLED, which stay OFF without it.
# GOWAY_API_URL=https://api.goway.to
# GOWAY_TIMEOUT_MS=2500
# GOWAY_PLACE_CACHE_TTL_SECONDS=60       # at most 60 — the shortest stock interval
# GOWAY_PLACE_STALE_TTL_SECONDS=86400    # last-good place while GoWay is down

# ================================
# LOGGING
# ================================
# LOG_LEVEL=info

# ================================
# NOTES
# ================================
# - Copy this file to .env and fill in your values.
# - Never commit .env to version control.

# Publish aggregate service traffic and infrastructure to the Oxy dashboard.
OXY_ECOSYSTEM_ACTIVITY_ENABLED=false
AWS_REGION=us-west-2
# Own service identity is the registered workload (Oxy ADR 0049).
# Peable, CrowdSource and Clarity use the shared workload SDK; no key pair.
