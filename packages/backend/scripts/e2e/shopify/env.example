# Shopify real-store verification (#69) — every variable the Shopify path reads.
#
# Derived from the CODE, not from a handoff table:
#   connectors/shopify/config.ts   SHOPIFY_CLIENT_ID / _CLIENT_SECRET / _SCOPES
#   connectors/config.ts           CONNECTOR_OAUTH_* (redirect base, state secret,
#                                  success redirect)
#   lib/connector-crypto.ts        CONNECTOR_ENCRYPTION_KEY
#   src/index.ts                   PORT (default 4160), DATABASE_URL
#
# `config/index.ts` exposes NOTHING Shopify-specific — the connector reads its
# credentials at use, so the API boots unconfigured and the connect flow fails
# with a clear configuration error instead of crashing at import.
#
# The `E2E_*` names are the SHARED driver harness's (scripts/e2e/config.ts), not
# a second convention.
#
# THE THREE SHOPIFY SECRETS ARE NOT HERE. They live in a mode-600 JSON file —
# see README §"Where the secrets live". This file holds only what the API
# process needs in its environment, and it must AGREE with that file (preflight
# refuses when it does not).
#
# Copy to a path OUTSIDE the repo and source it. Never commit a filled-in copy.

# ─────────────────────────────────────────────────────────────────────────────
# 1. What the API process needs
# ─────────────────────────────────────────────────────────────────────────────

# Must equal `clientId` / `clientSecret` in the credential file.
# The secret is BOTH the OAuth token-exchange secret AND the HMAC key for the
# OAuth callback and every inbound webhook. One value, three uses.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# OPTIONAL. Unset means the code default, which is the full set below and is
# what `shopify-scopes.test.ts` gates. Set it only to request something
# NARROWER — and expect `webhookFailures` to name the topics Shopify then
# refuses, plus a "degraded" catalogue axis on readiness.
# SHOPIFY_SCOPES=read_products,write_products,read_orders,read_inventory,read_locations,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders

# NO trailing slash. `tunnel.sh` prints the value to paste here. Two URLs are
# derived from it and BOTH must match the Shopify app's configuration:
#   {base}/channels/oauth/shopify/callback   (the app's redirect URL)
#   {base}/channels/webhooks/shopify         (the webhook delivery address)
CONNECTOR_OAUTH_REDIRECT_BASE_URL=

# HMAC key for the signed OAuth `state`. Protects the round trip, not Shopify.
# Generate: openssl rand -hex 32
CONNECTOR_OAUTH_STATE_SECRET=

# AES-256-GCM key for the stored access token and webhook secret envelopes.
# EXACTLY 64 hex characters. Generate: openssl rand -hex 32
# Without it every Shopify call fails at decryptAuth — AFTER a connect that
# reported success.
CONNECTOR_ENCRYPTION_KEY=

# OPTIONAL. Where the browser lands after a successful callback. Unset means a
# plain-text 200, which is fine for a verification run.
# CONNECTOR_OAUTH_SUCCESS_REDIRECT_URL=

DATABASE_URL=
PORT=4160

# ─────────────────────────────────────────────────────────────────────────────
# 2. What the DRIVER needs (read by preflight.ts / drive.ts, not by the API)
# ─────────────────────────────────────────────────────────────────────────────

# Where the driver reaches the API. LOCAL, not the tunnel: the tunnel exists so
# SHOPIFY can reach in, and driving through it would measure the tunnel too.
E2E_API_BASE_URL=http://127.0.0.1:4160

# An Oxy bearer token for an account holding `channels:write` on the store
# below. `owner` and `admin` both hold it; `staff` does not.
E2E_OXY_ACCESS_TOKEN=

# The Mercaria store the Shopify channel is connected to.
E2E_STORE_ID=

# Where evidence is written. Keep it OUTSIDE the repo — the artefacts name a
# real store.
E2E_EVIDENCE_DIR=

# OPTIONAL override. Default: ~/.config/oxy/tokens/mercaria-shopify-e2e.json
# E2E_SHOPIFY_CREDENTIALS_FILE=
