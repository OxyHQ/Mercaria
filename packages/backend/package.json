{
  "name": "@mercaria/backend",
  "version": "1.0.0",
  "description": "Mercaria API — buy/sell marketplace backend by Oxy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build.ts",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e-harness": "vitest run --config vitest.e2e.config.ts",
    "architecture:diagrams": "bun run scripts/generate-architecture-diagrams.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:rollback-plan": "bun run scripts/rollback-plan.ts",
    "fees:provision": "bun run src/scripts/provision-fee-schedule.ts"
  },
  "dependencies": {
    "@alia.onl/server": "1.1.0",
    "@goway.to/sdk": "0.3.0",
    "@mercaria/contracts": "workspace:*",
    "@mercaria/shared-types": "workspace:*",
    "@oxy.so/contracts": "4.9.0",
    "@oxy.so/core": "4.2.0",
    "@oxy.so/crowdsource": "^1.0.0",
    "@oxy.so/crowdsource-contracts": "^1.0.0",
    "@oxy.so/crowdsource-express": "^1.0.0",
    "@oxy.so/db": "^1.0.0",
    "@oxy.so/mcp": "1.1.0",
    "@peable.to/sdk": "^0.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.80.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "0.45.2",
    "esbuild": "^0.28.2",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "rate-limit-redis": "^5.0.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@mercaria.co/sdk": "workspace:*",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.43",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
