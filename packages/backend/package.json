{
  "name": "@mercaria/backend",
  "version": "1.0.0",
  "description": "Mercaria API \u2014 buy/sell marketplace backend by Oxy",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build.ts",
    "start": "node dist/index.js",
    "lint": "eslint src scripts build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e-harness": "vitest run --config vitest.e2e.config.ts",
    "architecture:diagrams": "bun run scripts/generate-architecture-diagrams.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:rollback-plan": "bun run scripts/rollback-plan.ts"
  },
  "dependencies": {
    "@mercaria/shared-types": "workspace:*",
    "@oxyhq/core": "^19.1.0",
    "@oxyhq/crowdsource": "0.3.0",
    "@oxyhq/crowdsource-contracts": "0.3.0",
    "@oxyhq/crowdsource-express": "0.3.0",
    "@oxyhq/db": "^0.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.80.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "0.45.2",
    "esbuild": "^0.27.7",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "rate-limit-redis": "^5.0.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.43",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
