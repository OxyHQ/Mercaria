{
  "expo": {
    "owner": "oxyhq",
    "name": "Wholesale by Mercaria",
    "slug": "mercaria-dashboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-512.png",
    "scheme": "mercariadashboard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.mercaria.dashboard"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-512-maskable.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#ff7a26"
      },
      "package": "co.mercaria.dashboard",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon-192.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      "@oxy.so/services/plugins/withOxySharedPermissions",
      "@oxy.so/app-preset/plugin/withOxyAndroidRelease"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
