    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "i18n-js": "^4.5.3",
    "lightningcss": "1.30.1",
    "lucide-react-native": "^0.562.0",
    "make-plural": "^7.5.0",
    "nanoid": "^3.3.16",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
