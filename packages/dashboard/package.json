{
  "name": "@mercaria/dashboard",
  "main": "index",
  "version": "1.0.0",
  "scripts": {
    "start": "RCT_METRO_PORT=8161 expo start --clear --tunnel",
    "dev": "RCT_METRO_PORT=8161 expo start --scheme mercariadashboard",
    "android": "RCT_METRO_PORT=8161 expo run:android",
    "ios": "RCT_METRO_PORT=8161 expo run:ios",
    "web": "RCT_METRO_PORT=8161 expo start --web",
    "build": "bun x expo export --platform web",
    "build:production": "NODE_ENV=production bun x expo export --platform web --clear",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "typecheck": "bun ../../scripts/generate-router-types.mjs && tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check . && bun run lint:expo",
    "lint:expo": "eslint ."
  },
  "dependencies": {
    "@expo/app-integrity": "~58.0.2",
    "@expo/html-elements": "~58.0.3",
    "@expo/vector-icons": "^15.1.1",
    "@goway.to/sdk": "0.3.0",
    "@hugeicons/react-native": "^1.0.15",
    "@mercaria/shared-types": "workspace:*",
    "@mercaria/ui": "workspace:*",
    "@oxy.so/app-preset": "3.3.0",
    "@oxy.so/bloom": "15.10.1",
    "@oxy.so/core": "7.3.0",
    "@oxy.so/services": "13.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/hooks": "^100.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.3.8",
    "@rn-primitives/hooks": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/types": "^1.5.2",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "event-target-shim": "^6.0.2",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
