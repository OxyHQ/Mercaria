{
  "name": "@mercaria.co/sdk",
  "version": "0.1.0",
  "description": "The canonical, headless TypeScript client for Mercaria's public commerce API \u2014 product, store and collection reads, portable references, typed errors and canonical links for Node, Bun, browsers and React Native.",
  "license": "Apache-2.0",
  "author": "The Oxy Collective, Inc.",
  "homepage": "https://github.com/OxyHQ/Mercaria/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Mercaria.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/OxyHQ/Mercaria/issues"
  },
  "keywords": [
    "mercaria",
    "oxy",
    "commerce",
    "marketplace",
    "sdk",
    "api-client"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build && bun run smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mercaria/shared-types": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "rollup": "^4.59.0",
    "rollup-plugin-dts": "~6.4.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
