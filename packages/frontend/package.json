{
  "name": "@mercaria/frontend",
  "main": "index",
  "version": "1.0.0",
  "scripts": {
    "start": "RCT_METRO_PORT=8160 expo start --clear --tunnel",
    "dev": "RCT_METRO_PORT=8160 expo start --scheme mercaria",
    "android": "RCT_METRO_PORT=8160 expo run:android",
    "ios": "RCT_METRO_PORT=8160 expo run:ios",
    "web": "RCT_METRO_PORT=8160 expo start --web",
    "build": "bun x expo export --platform web",
    "build:production": "NODE_ENV=production bun x expo export --platform web --clear",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "typecheck": "bun ../../scripts/generate-router-types.mjs && tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check . && bun run lint:expo",
    "lint:expo": "eslint ."
  },
