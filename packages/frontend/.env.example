# ================================
# EXPO APP CONFIGURATION
# ================================
# Mercaria API base URL.
EXPO_PUBLIC_API_URL=http://localhost:4160

# Oxy API base URL (used by the Oxy SDK / OxyProvider).
EXPO_PUBLIC_OXY_API_URL=https://api.oxy.so

# Oxy SSO client id. Empty uses Mercaria's registered public client identifier
# from lib/config.ts; set this only to use a separately registered dev client.
EXPO_PUBLIC_OXY_CLIENT_ID=

# GoWay's API origin: the store page reads each shop front's place (hours,
# photos, rating) from it. Optional: unset uses GoWay's canonical API.
EXPO_PUBLIC_GOWAY_API_URL=

# GoWay web origin, for "View on GoWay" links to a place.
# Optional: unset uses GoWay's canonical origin.
EXPO_PUBLIC_GOWAY_WEB_URL=

# Peable (the card rail). Both optional and PUBLIC: unset uses
# https://api.peable.to and https://checkout.peable.to. Point them elsewhere
# only together with the backend's PEABLE_BASE_URL.
EXPO_PUBLIC_PEABLE_GATEWAY_URL=
EXPO_PUBLIC_PEABLE_CHECKOUT_URL=

# ================================
# NOTES
# ================================
# - Copy this file to .env and fill in your values.
# - The EXPO_PUBLIC_ prefix exposes vars to the client bundle — never put
#   secrets in EXPO_PUBLIC_ variables.
