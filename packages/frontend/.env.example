# ================================
# EXPO APP CONFIGURATION
# ================================
# Mercaria API base URL.
EXPO_PUBLIC_API_URL=http://localhost:4160

# Oxy API base URL (used by the Oxy SDK / OxyProvider).
EXPO_PUBLIC_OXY_API_URL=https://api.oxy.so

# Oxy SSO client id (registered RP client for cross-app device sign-in / SSO).
# Leave EMPTY until the Oxy client is registered — the SDK SSO/cold-boot flow
# activates once this is set. See HANDOFF.md.
EXPO_PUBLIC_OXY_CLIENT_ID=

# ================================
# NOTES
# ================================
# - Copy this file to .env and fill in your values.
# - The EXPO_PUBLIC_ prefix exposes vars to the client bundle — never put
#   secrets in EXPO_PUBLIC_ variables.

# Stripe publishable key (pk_test_… / pk_live_…) — a PUBLIC value by design.
# The FALLBACK only: the checkout response carries the key belonging to the
# account that created the payment, and that one wins. Leave empty until the
# platform Stripe account exists; the payment step then says cards are
# unavailable instead of offering one that cannot work.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
