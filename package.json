{
  "name": "mercaria-monorepo",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Mercaria — buy/sell marketplace by Oxy",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter @mercaria/frontend dev -- --clear --tunnel",
    "dev:dashboard": "bun run --filter @mercaria/dashboard dev",
    "dev:pos": "bun run --filter @mercaria/pos dev",
    "dev:backend": "bun run --filter @mercaria/backend dev",
    "build": "bun run build:shared-types && bun run build:backend && bun run build:frontend",
    "build:shared-types": "bun run --filter @mercaria/shared-types build",
    "build:frontend": "bun run --filter @mercaria/frontend build",
    "build:dashboard": "bun run --filter @mercaria/dashboard build",
    "build:pos": "bun run --filter @mercaria/pos build",
    "build:backend": "bun run build:shared-types && bun run --filter @mercaria/backend build",
    "start:frontend": "bun run --filter @mercaria/frontend start",
    "start:backend": "bun run --filter @mercaria/backend start",
    "typecheck:ui": "bun run --filter @mercaria/ui typecheck",
    "lint": "bun run --filter '*' lint",
    "validate:no-mongo": "bun ./scripts/validate-no-mongo.mjs && bun ./scripts/test-validate-no-mongo.mjs",
    "validate:rtl-classes": "bun ./scripts/validate-rtl-logical-classes.mjs && bun ./scripts/test-validate-rtl-logical-classes.mjs && bun ./scripts/validate-rtl-direction.mjs && bun ./scripts/validate-logical-side.mjs && bun ./scripts/validate-rtl-upstream-premises.mjs && bun ./scripts/test-validate-rtl-upstream-premises.mjs",
    "validate:bidi-isolation": "bun ./scripts/validate-bidi-isolation.mjs",
    "validate:i18n-strings": "bun ./scripts/validate-i18n-strings.mjs && bun ./scripts/test-validate-i18n-strings.mjs",
    "validate:authoring-schema": "bun ./scripts/validate-authoring-schema-driven.mjs && bun ./scripts/test-validate-authoring-schema-driven.mjs",
    "validate:money-formatting": "bun ./scripts/validate-money-formatting.mjs && bun ./scripts/test-validate-money-formatting.mjs",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "validate:lint-coverage": "bun ./scripts/validate-lint-coverage.mjs && bun ./scripts/test-validate-lint-coverage.mjs",
    "validate:lock-capacity": "bun ./scripts/validate-lock-capacity.mjs && bun ./scripts/test-validate-lock-capacity.mjs",
    "validate:facet-label-copy": "bun ./scripts/validate-facet-label-copy.mjs",
    "validate:storefront-catalog": "bun ./scripts/validate-storefront-catalog-driven.mjs && bun ./scripts/test-validate-storefront-catalog-driven.mjs",
    "validate:route-targets": "bun ./scripts/validate-route-targets.mjs && bun ./scripts/test-validate-route-targets.mjs",
    "validate:catalog-identity-contracts": "bun ./scripts/validate-catalog-identity-contracts.mjs && bun ./scripts/test-validate-catalog-identity-contracts.mjs",
    "validate:no-content-revert": "bun ./scripts/validate-no-content-revert.mjs",
    "validate:no-content-revert-controls": "bun ./scripts/test-validate-no-content-revert.mjs",
    "android": "bun run --filter @mercaria/frontend android",
    "ios": "bun run --filter @mercaria/frontend ios",
    "web": "bun run --filter @mercaria/frontend web",
    "seed:verticals": "bun run --cwd packages/backend src/scripts/seed-verticals/index.ts",
  "postinstall": "bun run --filter @mercaria/shared-types build"
  },
  "keywords": [
    "monorepo",
    "marketplace",
    "expo",
    "api",
    "ecommerce"
  ],
  "author": "",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.8.3",
    "react-native-reanimated": "4.3.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "56.0.4",
    "expo-file-system": "56.0.8",
    "react-native-screens": "4.25.2",
    "react-native-gesture-handler": "2.31.1",
    "react-native-keyboard-controller": "1.20.7",
    "expo": "56.0.11",
    "expo-blur": "56.0.3",
    "expo-constants": "56.0.18",
    "expo-font": "56.0.6",
    "expo-image": "56.0.11",
    "@react-native-menu/menu": "2.0.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/metro-babel-transformer": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@oxyhq/core": "^19.1.0",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1"
  },
  "dependencies": {
    "@oxyhq/core": "^19.1.0"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core"
  ]
}
